# Copie este arquivo para ".env" e ajuste os valores.
# O .env NÃO vai para o Git (contém segredos).

# Chave secreta (obrigatória em produção). Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria

# "production" ativa cookies seguros e exige SECRET_KEY de verdade.
# Deixe vazio no seu computador.
FLASK_ENV=

# Banco de dados. Vazio = SQLite local (instance/quadrapro.db).
# Produção (PostgreSQL):
# DATABASE_URL=postgresql://usuario:senha@servidor:5432/quadrapro
DATABASE_URL=

# E-mail para "Esqueci minha senha" (opcional no seu computador).
# Exemplo com Gmail: crie uma "senha de app" em myaccount.google.com/apppasswords
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
